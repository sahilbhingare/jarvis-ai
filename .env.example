# Google Gemini API Key (Optional: get free key at https://aistudio.google.com)
# If left empty, Jarvis will use built-in smart web/knowledge search brain!
GEMINI_API_KEY=

# Assistant Name
JARVIS_NAME=JARVIS

# Voices (Edge-TTS Neural voices)
# English: en-US-ChristopherNeural, en-GB-RyanNeural, en-IN-PrabhatNeural
# Marathi: mr-IN-AarohiNeural, mr-IN-ManoharNeural
# Hindi: hi-IN-MadhurNeural, hi-IN-SwaraNeural
VOICE_EN=en-US-ChristopherNeural
VOICE_MR=mr-IN-AarohiNeural
VOICE_HI=hi-IN-MadhurNeural

PORT=5000
